{
  "name": "foodguide-app",
  "version": "1.2.5",
  "description": "Desktop app version of the unofficial Food Guide",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:app && npm run test:guide",
    "test:guide": "npm --prefix app/foodguide test",
    "lint": "eslint . --max-warnings 0 && npm --prefix app/foodguide run lint",
    "format:check": "prettier --check . && npm --prefix app/foodguide run format:check",
    "typecheck": "npm --prefix app/foodguide run typecheck",
    "check": "npm run test && npm run lint && npm run format:check && npm run typecheck",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test:app": "node --test tests/*.test.cjs",
    "test:electron": "npm run generate-assets && node scripts/test-electron.mjs",
    "generate-assets": "node scripts/generate-assets.mjs"
  },
  "author": "bluehexagons",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@reforged/maker-appimage": "^5.3.1",
    "electron": "^44.7.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "@reforged/maker-appimage": {
      "@electron-forge/maker-base": "8.0.1"
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
