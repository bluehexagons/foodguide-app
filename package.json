{
  "name": "foodguide-app",
  "version": "1.2.5",
  "description": "Desktop app version of the unofficial Food Guide",
  "main": "dist/index.cjs",
  "scripts": {
    "audit": "npm audit && npm --prefix app/foodguide audit",
    "test": "npm run test:app && npm run test:guide",
    "test:guide": "npm --prefix app/foodguide test",
    "lint": "oxlint --disable-nested-config --deny-warnings && npm --prefix app/foodguide run lint",
    "format:check": "oxfmt --disable-nested-config --check && npm --prefix app/foodguide run format:check",
    "typecheck": "npm run build:app && tsc -p tsconfig.forge.json && npm --prefix app/foodguide run typecheck",
    "check": "npm run test && npm run lint && npm run format:check && npm run typecheck",
    "start": "npm run build && electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "test:app": "npm run build:app && node --test tests/*.test.cjs",
    "test:electron": "npm run generate-assets && node dist/scripts/test-electron.mjs",
    "generate-assets": "npm run build && node dist/scripts/generate-assets.mjs",
    "build:app": "npm run build:guide && tsc",
    "build:guide": "npm --prefix app/foodguide run build",
    "build": "npm run build:app",
    "lint:fix": "oxlint --disable-nested-config --fix --deny-warnings && npm --prefix app/foodguide run lint:fix",
    "format": "oxfmt --disable-nested-config",
    "fix": "npm run lint:fix && npm run format && npm --prefix app/foodguide run format"
  },
  "author": "bluehexagons",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@foodguide/image-size-compat": "file:tools/image-size-compat",
    "@reforged/maker-appimage": "^5.3.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "es-module-lexer": "^3.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "appdmg": {
      "image-size": "file:../../tools/image-size-compat"
    },
    "@reforged/maker-appimage": {
      "@electron-forge/maker-base": "8.0.1"
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
